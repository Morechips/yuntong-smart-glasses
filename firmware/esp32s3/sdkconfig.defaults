# Sanitized reconstruction defaults; configure Wi-Fi in menuconfig.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_LWIP_MAX_SOCKETS=10
CONFIG_CODEC_ES8311_SUPPORT=y
CONFIG_CODEC_ES7210_SUPPORT=y
CONFIG_CODEC_ES7243_SUPPORT=n
CONFIG_CODEC_ES7243E_SUPPORT=n
CONFIG_CODEC_ES8156_SUPPORT=n
CONFIG_CODEC_AW88298_SUPPORT=n
CONFIG_CODEC_ES8389_SUPPORT=n
CONFIG_CODEC_ES8374_SUPPORT=n
CONFIG_CODEC_ES8388_SUPPORT=n
CONFIG_CODEC_TAS5805M_SUPPORT=n
CONFIG_CAM_WIFI_SSID="YOUR_WIFI_SSID"
CONFIG_CAM_FRAME_SIZE_VGA=y
CONFIG_CAM_JPEG_QUALITY=16
CONFIG_CAM_FB_COUNT=3
CONFIG_GLASSES_TRANSPORT_ENABLE=n
CONFIG_CAM_HTTP_SERVER_ENABLE=y
CONFIG_CAM_HTTP_STREAM_ENABLE=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_GLASSES_PERIPHERAL_BENCH_ENABLE=y
CONFIG_GLASSES_BENCH_MOTOR_ENABLE=y
CONFIG_GLASSES_BENCH_MOTOR_CYCLE_ENABLE=n
CONFIG_CAM_WIFI_PASSWORD=""
CONFIG_GLASSES_IMU_SYNC_ENABLE=y
CONFIG_GLASSES_IMU_POLL_HZ=50
CONFIG_GLASSES_IMU_TIMEOUT_MS=8
