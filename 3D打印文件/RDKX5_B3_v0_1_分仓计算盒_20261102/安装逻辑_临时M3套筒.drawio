<mxfile host="app.diagrams.net" type="device"><diagram id="b3-m2-through" name="临时装法安装逻辑"><mxGraphModel page="1" pageWidth="1500" pageHeight="1130"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c2" value="B3安装逻辑｜M3铜柱作套筒，M2×16贯穿锁紧" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EDF3F7;strokeColor=#EDF3F7;fontSize=34;fontColor=#233E50;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="18" width="1440" height="64" /></mxCell><mxCell id="c3" value="先断开电池和USB；图为安装顺序示意，不按比例画。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EDF3F7;strokeColor=#EDF3F7;fontSize=23;fontColor=#233E50;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="86" width="1440" height="48" /></mxCell><mxCell id="c4" value="① 空壳预放&#10;M3螺母" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E2F0EC;strokeColor=#69A493;fontSize=23;fontColor=#233E50;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="160" width="270" height="96" /></mxCell><mxCell id="c5" value="② 固定下层&#10;P23C电源板" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E2F0EC;strokeColor=#69A493;fontSize=23;fontColor=#233E50;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry as="geometry" x="325" y="160" width="270" height="96" /></mxCell><mxCell id="c6" value="③ 桌上装好&#10;X5＋横框模块" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E2F0EC;strokeColor=#69A493;fontSize=23;fontColor=#233E50;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry as="geometry" x="615" y="160" width="270" height="96" /></mxCell><mxCell id="c7" value="④ 装上层、侧板&#10;再放电池与原线" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E2F0EC;strokeColor=#69A493;fontSize=23;fontColor=#233E50;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry as="geometry" x="905" y="160" width="270" height="96" /></mxCell><mxCell id="c8" value="⑤ 合盖、装背桥&#10;最后接外部线" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E2F0EC;strokeColor=#69A