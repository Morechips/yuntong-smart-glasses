ometry" x="135" y="585" width="570" height="45" /></mxCell><mxCell id="c16" value="打印底座的安装台" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E1EBF2;strokeColor=#C1CDD5;fontSize=24;fontColor=#233E50;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry as="geometry" x="135" y="640" width="570" height="45" /></mxCell><mxCell id="c17" value="背面垫片" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#C1CDD5;fontSize=24;fontColor=#233E50;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry as="geometry" x="135" y="695" width="570" height="45" /></mxCell><mxCell id="c18" value="M2×16螺丝头（底端）" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#C1CDD5;fontSize=24;fontColor=#233E50;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry as="geometry" x="135" y="750" width="570" height="45" /></mxCell><mxCell id="c19" value="M2螺丝从下往上穿过整叠，顶端拧M2螺母" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF1D9;strokeColor=#E1B365;fontSize=24;fontColor=#233E50;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="825" width="680" height="58" /></mxCell><mxCell id="c20" value="M2螺母（顶端）" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#C1CDD5;fontSize=24;fontColor=#233E50;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry as="geometry" x="865" y="365" width="570" height="45" /></mxCell><mxCell id="c21" value="绝缘垫片" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#C1CDD5;fontSize=24;fontColor=#233E50;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry as="geometry" x="865" y="420" width="570" height="45" /></mxCell><mxCell id="c22" value="04号打印横框" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E1EBF2;strokeColor=#C1CDD5;fontSize=24;fontColor=#233E50;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry as="geometry" x="865" y="475" width="570" height="45" /></mxCell><mxCell id="c23" value="M3双通铜柱｜柱身8mm" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F3E2BC;strokeColor=#C1CDD5;fontSize=24;fontColor=#233E50;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry as="geometry" x="865" y="530" width="570" height="45" /></mxCell><mxCell id="c24" value="绝缘垫片" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#C1CDD5;fontSize=24;fontColor=#233E50;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry as="geometry" x="865" y="585" width="570" height="45" /></mxCell><mxCell id="c25" value="X5主板｜元件朝上" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DDEFE6;strokeColor=#C1CDD5;fontSize=24;fontColor=#233E50;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry as="geometry" x="865" y="640" width="570" height="45" /></mxCell><mxCell id="c26" value="板背绝缘垫片" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#C1CDD5;fontSize=24;fontColor=#233E50;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry as="geometry" x="865" y="695" width="570" height="45" /></mxCell><mxCell id="c27" value="M2×16螺丝头（底端）" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#C1CDD5;fontSize=24;fontColor=#233E50;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry as="geometry" x="865" y="750" width="570" height="45" /></mxCell><mxCell id="c28" value="M2螺丝从下往上穿过整叠，顶端拧M2螺母" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF1D9;strokeColor=#E1B365;fontSize=24;fontColor=#233E50;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry as="geometry" x="775" y="825" width="680" height="58" /></mxCell><mxCell id="c29" value="铜柱只负责撑开8mm：M2螺杆自由穿过铜柱，不去拧铜柱的M3内螺纹。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#C4D0DA;fontSize=24;fontColor=#233E50;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="915" width="1430" height="62" /></mxCell><mxCell id="c30" value="输出公头 → P23C的DC口；P23C的USB输出 → X5电源C口（看板上丝印）&#10;充电母头留在电池侧仓；带子侧放进背桥后锁回，不压电池。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E2F0EC;strokeColor=#69A493;fontSize=23;fontColor=#233E50;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="990" width="1430" height="86" /></mxCell></root></mxGraphModel></diagram></mxfile>
