<mxfile host="app.diagrams.net" type="device"><diagram id="01" name="01_当前版结构拆解与认件"><mxGraphModel page="1" pageWidth="2200" pageHeight="1690" grid="0" background="#EEF3F7"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="当前打印版 v0.5｜结构拆解与认件" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=43;fontColor=#193446;" vertex="1" parent="1"><mxGeometry as="geometry" x="42" y="25" width="2133" height="64.5" /></mxCell><mxCell id="3" value="对应你手上8件3MF；盖子和元件上提展示。编号对应下方备注，不表示装配间隙。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=27;fontColor=#5B7180;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="88" width="2130" height="40.5" /></mxCell><mxCell id="4" value="" style="rounded=1;arcSize=3;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="150" width="1060" height="1235" /></mxCell><mxCell id="5" value="" style="rounded=1;arcSize=3;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1115" y="150" width="1060" height="1235" /></mxCell><mxCell id="6" value="左 / 右振动盒：每侧3个打印件" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=32;fontColor=#187D71;" vertex="1" parent="1"><mxGeometry as="geometry" x="53" y="172" width="2122" height="48.0" /></mxCell><mxCell id="7" value="2209扬声器盒：2个打印件" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=32;fontColor=#187D71;" vertex="1" parent="1"><mxGeometry as="geometry" x="1143" y="172" width="1032" height="48.0" /></mxCell><mxCell id="8" value="" style="shape=image;imageAspect=0;image=data:image/png,;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="225" width="1020" height="765" /></mxCell><mxCell id="9" value="" style="shape=image;imageAspect=0;image=data:image/png,;" vertex="1" parent="1"><mxGeometry as="geometry" x="1135" y="225" width="1020" height="765" /></mxCell><mxCell id="10" style="endArrow=none;strokeColor=#286A94;strokeWidth=3;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="targetPoint" x="583.994431178531" y="503.55928234898136" /><mxPoint as="sourcePoint" x="651.994431178531" y="471.55928234898136" /></mxGeometry></mxCell><mxCell id="11" value="1" style="ellipse;fillColor=#286A94;strokeColor=#FFFFFF;strokeWidth=3;fontColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=24;" vertex="1" parent="1"><mxGeometry as="geometry" x="623.994431178531" y="443.55928234898136" width="56" height="56" /></mxCell><mxCell id="12" style="endArrow=none;strokeColor=#286A94;strokeWidth=3;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="targetPoint" x="501.06021125695145" y="638.3825712675725" /><mxPoint as="sourcePoint" x="406.06021125695145" y="628.3825712675725" /></mxGeometry></mxCell><mxCell id="13" value="2" style="ellipse;fillColor=#286A94;strokeColor=#FFFFFF;strokeWidth=3;fontColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=24;" vertex="1" parent="1"><mxGeometry as="geometry" x="378.06021125695145" y="600.3825712675725" width="56" height="56" /></mxCell><mxCell id="14" style="endArrow=none;strokeColor=#286A94;strokeWidth=3;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="targetPoint" x="667.2649277140856" y="706.9537283560264" /><mxPoint as="sourcePoint" x="755.2649277140856" y="686.9537283560264" /></mxGeometry></mxCell><mxCell id="15" value="3" style="ellipse;fillColor=#286A94;strokeColor=#FFFFFF;strokeWidth=3;fontColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=24;" vertex="1" parent="1"><mxGeometry as="geometry" x="727.2649277140856" y="658.9537283560264" width="56" height="56" /></mxCell><mxCell id="16" style="endArrow=none;strokeColor=#286A94;strokeWidth=3;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="targetPoint" x="411.2743553256316" y="784.5698684257211" /><mxPoint as="sourcePoint" x="341.2743553256316" y="826.5698684257211" /></mxGeometry></mxCell><mxCell id="17" value="4" style="ellipse;fillColor=#286A94;strokeColor=#FFFFFF;strokeWidth=3;fontColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=24;" vertex="1" parent="1"><mxGeometry as="geometry" x="313.2743553256316" y="798.5698684257211" width="56" height="56" /></mxCell><mxCell id="18" style="endArrow=none;strokeColor=#286A94;strokeWidth=3;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="targetPoint" x="1629.6223413258467" y="551.3177624632552" /><mxPoint as="sourcePoint" x="1697.6223413258467" y="514.3177624632552" /></mxGeometry></mxCell><mxCell id="19" value="5" style="ellipse;fillColor=#286A94;strokeColor=#FFFFFF;strokeWidth=3;fontColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=24;" vertex="1" parent="1"><mxGeometry as="geometry" x="1669.6223413258467" y="486.31776246325524" width="56" height="56" /></mxCell><mxCell id="20" style="endArrow=none;strokeColor=#286A94;strokeWidth=3;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="targetPoint" x="1629.0434389500301" y="697.1548511483315" /><mxPoint as="sourcePoint" x="1551.0434389500301" y="690.1548511483315" /></mxGeometry></mxCell><mxCell id="21" value="6" style="ellipse;fillColor=#286A94;strokeColor=#FFFFFF;strokeWidth=3;fontColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=24;" vertex="1" parent="1"><mxGeometry as="geometry" x="1523.0434389500301" y="662.1548511483315" width="56" height="56" /></mxCell><mxCell id="22" style="endArrow=none;strokeColor=#286A94;strokeWidth=3;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="targetPoint" x="1585.5185566201283" y="817.2047222496724" /><mxPoint as="sourcePoint" x="1509.5185566201283" y="859.2047222496724" /></mxGeometry></mxCell><mxCell id="23" value="7" style="ellipse;fillColor=#286A94;strokeColor=#FFFFFF;strokeWidth=3;fontColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=24;" vertex="1" parent="1"><mxGeometry as="geometry" x="1481.5185566201283" y="831.2047222496724" width="56" height="56" /></mxCell><mxCell id="24" style="endArrow=none;strokeColor=#286A94;strokeWidth=3;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="targetPoint" x="1733.6746831716664" y="609.256056008235" /><mxPoint as="sourcePoint" x="1818.6746831716664" y="625.256056008235" /></mxGeometry></mxCell><mxCell id="25" value="8" style="ellipse;fillColor=#286A94;strokeColor=#FFFFFF;strokeWidth=3;fontColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=24;" vertex="1" parent="1"><mxGeometry as="geometry" x="1790.6746831716664" y="597.256056008235" width="56" height="56" /></mxCell><mxCell id="26" value="① 穿带盖 H02" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=29;fontColor=#187D71;" vertex="1" parent="1"><mxGeometry as="geometry" x="55" y="1013" width="2120" height="43.5" /></mxCell><mxCell id="27" value="两条穿带桥是本体；每盖用2颗M2×10从两端拧。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=24;fontColor=#193446;" vertex="1" parent="1"><mxGeometry as="geometry" x="55" y="1052" width="2120" height="36.0" /></mxCell><mxCell id="28" value="② M3螺母定位条 H03" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=29;fontColor=#187D71;" vertex="1" parent="1"><mxGeometry as="geometry" x="55" y="1101" width="2120" height="43.5" /></mxCell><mxCell id="29" value="先装2颗普通M3螺母；这个小条要保留。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=24;fontColor=#193446;" vertex="1" parent="1"><mxGeometry as="geometry" x="55" y="1140" width="2120" height="36.0" /></mxCell><mxCell id="30" value="③ 完整振动模块" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=29;fontColor=#187D71;" vertex="1" parent="1"><mxGeometry as="geometry" x="55" y="1189" width="2120" height="43.5" /></mxCell><mxCell id="31" value="保留马达、PCB和正面弯针接头；两板孔独立固定。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=24;fontColor=#193446;" vertex="1" parent="1"><mxGeometry as="geometry" x="55" y="1228" width="2120" height="36.0" /></mxCell><mxCell id="32" value="④ 盒体 H01 / 居中出线槽" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=29;fontColor=#187D71;" vertex="1" parent="1"><mxGeometry as="geometry" x="55" y="1277" width="2120" height="43.5" /></mxCell><mxCell id="33" value="内部支承是本体；导线开盖放入，出口保持居中。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=24;fontColor=#193446;" vertex="1" parent="1"><mxGeometry as="geometry" x="55" y="1316" width="2120" height="36.0" /></mxCell><mxCell id="34" value="⑤ 穿带盖 S02" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=29;fontColor=#187D71;" vertex="1" parent="1"><mxGeometry as="geometry" x="1145" y="1013" width="1030" height="43.5" /></mxCell><mxCell id="35" value="螺母先放进盖侧槽；穿带桥是本体。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=24;fontColor=#193446;" vertex="1" parent="1"><mxGeometry as="geometry" x="1145" y="1052" width="1030" height="36.0" /></mxCell><mxCell id="36" value="⑥ 2209单元外廓 22×9×4mm" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=29;fontColor=#187D71;" vertex="1" parent="1"><mxGeometry as="geometry" x="1145" y="1101" width="1030" height="43.5" /></mxCell><mxCell id="37" value="灰块是外形参考；只支撑实际硬边，不压振膜。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=24;fontColor=#193446;" vertex="1" parent="1"><mxGeometry as="geometry" x="1145" y="1140" width="1030" height="36.0" /></mxCell><mxCell id="38" value="⑦ 盒体 S01 / 出音槽" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=29;fontColor=#187D71;" vertex="1" parent="1"><mxGeometry as="geometry" x="1145" y="1189" width="1030" height="43.5" /></mxCell><mxCell id="39" value="出音槽在另一面，下张图显示；短边出线。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=24;fontColor=#193446;" vertex="1" parent="1"><mxGeometry as="geometry" x="1145" y="1228" width="1030" height="36.0" /></mxCell><mxCell id="40" value="⑧ 盒盖侧向螺丝" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=29;fontColor=#187D71;" vertex="1" parent="1"><mxGeometry as="geometry" x="1145" y="1277" width="1030" height="43.5" /></mxCell><mxCell id="41" value="2颗M2×10从侧面拧，避开穿带桥和织带。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=24;fontColor=#193446;" vertex="1" parent="1"><mxGeometry as="geometry" x="1145" y="1316" width="1030" height="36.0" /></mxCell><mxCell id="42" value="8件 = 两只振动盒各「盒体＋盖子＋定位条」共6件，另加扬声器盒体＋盖子2件。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=30;fontColor=#193446;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="1414" width="2130" height="45.0" /></mxCell><mxCell id="43" value="蓝色 / 灰色 / 金色仅为认件配色，全部可用同一种PETG打印；螺丝、元件、织带不是打印件。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=25;fontColor=#5B7180;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="1472" width="2130" height="37.5" /></mxCell><mxCell id="44" value="M3固定板：现有平底盘头，头下杆长按5.5mm；M2×10锁盖。螺母均为普通六角螺母。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=25;fontColor=#193446;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="1521" width="2130" height="37.5" /></mxCell><mxCell id="45" value="本图不画生成支撑；孔柱、桥、小定位条均须保留。实际贴合、强度、声音与触感仍待试装。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=25;fontColor=#A5641C;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="1570" width="2130" height="37.5" /></mxCell><mxCell id="46" value="盒体塑料外廓（含桥）：每只振动盒40.6×29.3×19.8mm；扬声器盒36×29.3×16.6mm。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=25;fontColor=#5B7180;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="1620" width="2130" height="37.5" /></mxCell></root></mxGraphModel></diagram><diagram id="02" name="02_安装朝向与底部螺丝"><mxGraphModel page="1" pageWidth="2200" pageHeight="1240" grid="0" background="#EEF3F7"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="装好后怎么看｜穿带、出声与M3螺丝" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=43;fontColor=#193446;" vertex="1" parent="1"><mxGeometry as="geometry" x="42" y="25" width="2133" height="64.5" /></mxCell><mxCell id="3" value="真实v0.5网格；三个视图分别放大，比例不同。黑色织带仅表示25mm宽的安装关系。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=27;fontColor=#5B7180;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="87" width="2130" height="40.5" /></mxCell><mxCell id="4" value="" style="rounded=1;arcSize=3;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="150" width="690" height="825" /></mxCell><mxCell id="5" value="" style="rounded=1;arcSize=3;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="755" y="150" width="690" height="825" /></mxCell><mxCell id="6" value="" style="rounded=1;arcSize=3;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1485" y="150" width="690" height="825" /></mxCell><mxCell id="7" value="A  振动盒装好后的方向" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=29;fontColor=#187D71;" vertex="1" parent="1"><mxGeometry as="geometry" x="52" y="176" width="2123" height="43.5" /></mxCell><mxCell id="8" value="B  振动盒底面" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=29;fontColor=#187D71;" vertex="1" parent="1"><mxGeometry as="geometry" x="782" y="176" width="1393" height="43.5" /></mxCell><mxCell id="9" value="C  扬声器出音面" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=29;fontColor=#187D71;" vertex="1" parent="1"><mxGeometry as="geometry" x="1512" y="176" width="663" height="43.5" /></mxCell><mxCell id="10" value="" style="shape=image;imageAspect=0;image=data:image/png,;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="240" width="650" height="485" /></mxCell><mxCell id="11" value="" style="shape=image;imageAspect=0;image=data:image/png,;" vertex="1" parent="1"><mxGeometry as="geometry" x="775" y="240" width="650" height="485" /></mxCell><mxCell id="12" value="" style="shape=image;imageAspect=0;image=data:image/png,;" vertex="1" parent="1"><mxGeometry as="geometry" x="1505" y="240" width="650" height="485" /></mxCell><mxCell id="13" style="endArrow=none;strokeColor=#286A94;strokeWidth=3;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="targetPoint" x="370.0" y="446.89469004171804" /><mxPoint as="sourcePoint" x="412.0" y="364.89469004171804" /></mxGeometry></mxCell><mxCell id="14" value="带" style="ellipse;fillColor=#286A94;strokeColor=#FFFFFF;strokeWidth=3;fontColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=24;" vertex="1" parent="1"><mxGeometry as="geometry" x="384.0" y="336.89469004171804" width="56" height="56" /></mxCell><mxCell id="15" style="endArrow=none;strokeColor=#286A94;strokeWidth=3;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="targetPoint" x="340.1970443349754" y="577.372512800794" /><mxPoint as="sourcePoint" x="335.1970443349754" y="658.372512800794" /></mxGeometry></mxCell><mxCell id="16" value="头" style="ellipse;fillColor=#286A94;strokeColor=#FFFFFF;strokeWidth=3;fontColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=24;" vertex="1" parent="1"><mxGeometry as="geometry" x="307.1970443349754" y="630.372512800794" width="56" height="56" /></mxCell><mxCell id="17" style="endArrow=none;strokeColor=#286A94;strokeWidth=3;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="targetPoint" x="1053.525749836008" y="472.84453360096677" /><mxPoint as="sourcePoint" x="1129.525749836008" y="490.84453360096677" /></mxGeometry></mxCell><mxCell id="18" value="M3" style="ellipse;fillColor=#286A94;strokeColor=#FFFFFF;strokeWidth=3;fontColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=24;" vertex="1" parent="1"><mxGeometry as="geometry" x="1101.525749836008" y="462.84453360096677" width="56" height="56" /></mxCell><mxCell id="19" style="endArrow=none;strokeColor=#286A94;strokeWidth=3;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="targetPoint" x="1097.2003463756632" y="579.955840854242" /><mxPoint as="sourcePoint" x="1021.2003463756632" y="597.955840854242" /></mxGeometry></mxCell><mxCell id="20" value="M3" style="ellipse;fillColor=#286A94;strokeColor=#FFFFFF;strokeWidth=3;fontColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=24;" vertex="1" parent="1"><mxGeometry as="geometry" x="993.2003463756632" y="569.955840854242" width="56" height="56" /></mxCell><mxCell id="21" style="endArrow=none;strokeColor=#286A94;strokeWidth=3;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="targetPoint" x="1830.0" y="549.3607906394525" /><mxPoint as="sourcePoint" x="1890.0" y="637.3607906394525" /></mxGeometry></mxCell><mxCell id="22" value="音" style="ellipse;fillColor=#286A94;strokeColor=#FFFFFF;strokeWidth=3;fontColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=24;" vertex="1" parent="1"><mxGeometry as="geometry" x="1862.0" y="609.3607906394525" width="56" height="56" /></mxCell><mxCell id="23" value="织带从盖子的两个桥下穿过。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=25;fontColor=#193446;" vertex="1" parent="1"><mxGeometry as="geometry" x="55" y="752" width="2120" height="37.5" /></mxCell><mxCell id="24" value="盒底朝头侧，盖子/穿带桥朝外。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=25;fontColor=#193446;" vertex="1" parent="1"><mxGeometry as="geometry" x="55" y="799" width="2120" height="37.5" /></mxCell><mxCell id="25" value="原线沿带固定，接头附近留松弯。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=25;fontColor=#193446;" vertex="1" parent="1"><mxGeometry as="geometry" x="55" y="846" width="2120" height="37.5" /></mxCell><mxCell id="26" value="本版没有另加软隔振结构。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=25;fontColor=#A5641C;" vertex="1" parent="1"><mxGeometry as="geometry" x="55" y="893" width="2120" height="37.5" /></mxCell><mxCell id="27" value="2颗M3从底面圆凹位装入。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=25;fontColor=#193446;" vertex="1" parent="1"><mxGeometry as="geometry" x="785" y="752" width="1390" height="37.5" /></mxCell><mxCell id="28" value="穿过支承和PCB，拧入定位条螺母。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=25;fontColor=#193446;" vertex="1" parent="1"><mxGeometry as="geometry" x="785" y="799" width="1390" height="37.5" /></mxCell><mxCell id="29" value="盘头留在凹位中，不当作贴头凸点。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=25;fontColor=#193446;" vertex="1" parent="1"><mxGeometry as="geometry" x="785" y="846" width="1390" height="37.5" /></mxCell><mxCell id="30" value="盖子另用M2锁，不靠盖子压住PCB。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=25;fontColor=#A5641C;" vertex="1" parent="1"><mxGeometry as="geometry" x="785" y="893" width="1390" height="37.5" /></mxCell><mxCell id="31" value="长条出音槽保持露出。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=25;fontColor=#193446;" vertex="1" parent="1"><mxGeometry as="geometry" x="1515" y="752" width="660" height="37.5" /></mxCell><mxCell id="32" value="避开织带、皮肤和泡棉堵槽。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=25;fontColor=#193446;" vertex="1" parent="1"><mxGeometry as="geometry" x="1515" y="799" width="660" height="37.5" /></mxCell><mxCell id="33" value="单元硬边薄垫定位，别把胶贴上振膜。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=25;fontColor=#193446;" vertex="1" parent="1"><mxGeometry as="geometry" x="1515" y="846" width="660" height="37.5" /></mxCell><mxCell id="34" value="线从端部槽放出，在盒外止拉。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=25;fontColor=#A5641C;" vertex="1" parent="1"><mxGeometry as="geometry" x="1515" y="893" width="660" height="37.5" /></mxCell><mxCell id="35" value="先装螺母 → 放模块并固定 → 放原线 → 合盖 → 拧M2 → 穿带和调整位置。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=32;fontColor=#187D71;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="1015" width="2130" height="48.0" /></mxCell><mxCell id="36" value="螺丝合计：M2×10六颗＋普通M2螺母六颗；现有M3盘头四颗＋普通M3螺母四颗。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=28;fontColor=#193446;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="1077" width="2130" height="42.0" /></mxCell><mxCell id="37" value="本批没有电池盒。电池按现有方案粘在前罩背板后侧；贴头间隙、粘贴和引线需实摆。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=26;fontColor=#5B7180;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="1132" width="2130" height="39.0" /></mxCell><mxCell id="38" value="当前图对应原v0.5文件；未采用已停用的补边/斜筋候选，也未修改打印方向或3MF。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=25;fontColor=#5B7180;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="1182" width="2130" height="37.5" /></mxCell></root></mxGraphModel></diagram></mxfile>
